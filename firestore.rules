rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is authenticated with a verified email
    function isVerifiedUser(userId) {
      return request.auth != null &&
             request.auth.uid == userId &&
             request.auth.token.email_verified == true;
    }

    // Check if a field is a valid timestamp or numeric epoch milliseconds
    function isValidTimeField(val) {
      return val is timestamp || val is int || val is number;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate user profile schema and constraints for client updates
    function isValidUser(data, userId) {
      let requiredFields = ['fullName', 'email', 'phone', 'dob'];
      let allowedFields = [
        'fullName', 'email', 'phone', 'fullPhone', 'dob',
        'defaultTimes', 'pharmacy', 'prescriber',
        'pharmacyName', 'pharmacyContact', 'pharmacyAddress',
        'doctorName', 'doctorContact',
        'createdAt', 'updatedAt', 'id', 'uid'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             // fullName validation (letters and spaces, 1..100)
             data.fullName is string &&
             data.fullName.size() >= 1 &&
             data.fullName.size() <= 100 &&
             // email validation (must end with @gmail.com)
             data.email is string &&
             data.email.size() >= 11 &&
             data.email.size() <= 100 &&
             data.email.matches('^[a-zA-Z0-9._%+-]+@gmail[.]com$') &&
             // phone validation (masked or 10-digit format)
             data.phone is string &&
             data.phone.size() <= 20 &&
             // optional fullPhone validation
             (!('fullPhone' in data) || (data.fullPhone is string && (data.fullPhone == '' || data.fullPhone.matches('^[0-9]{10}$')))) &&
             // dob validation (YYYY-MM-DD or empty)
             data.dob is string &&
             (data.dob == '' || data.dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
             // timestamps
             ('createdAt' in data && isValidTimeField(data.createdAt)) &&
             ('updatedAt' in data && isValidTimeField(data.updatedAt)) &&
             // optional maps
             (!('defaultTimes' in data) || (data.defaultTimes is map && data.defaultTimes.keys().size() <= 20)) &&
             (!('pharmacy' in data) || (data.pharmacy is map && data.pharmacy.keys().size() <= 20)) &&
             (!('prescriber' in data) || (data.prescriber is map && data.prescriber.keys().size() <= 20)) &&
             // optional flat contact fields
             (!('pharmacyName' in data) || (data.pharmacyName is string && data.pharmacyName.size() <= 100)) &&
             (!('pharmacyContact' in data) || (data.pharmacyContact is string && data.pharmacyContact.size() <= 50)) &&
             (!('pharmacyAddress' in data) || (data.pharmacyAddress is string && data.pharmacyAddress.size() <= 200)) &&
             (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() <= 100)) &&
             (!('doctorContact' in data) || (data.doctorContact is string && data.doctorContact.size() <= 50)) &&
             // identity scoping
             (!('uid' in data) || data.uid == userId) &&
             (!('id' in data) || data.id == userId);
    }

    // Validate user profile update (protects immutable fields createdAt and uid)
    function isUserUpdateValid(userId) {
      return isValidUser(request.resource.data, userId) &&
             (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
             (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid) &&
             (!('id' in resource.data) || request.resource.data.id == resource.data.id);
    }

    // Validate medicine document schema and constraints
    function isValidMedicine(data, medicineId, userId) {
      let requiredFields = ['id', 'name', 'dosage', 'form', 'reminderTimes'];
      let allowedFields = [
        'id', 'name', 'dosage', 'form', 'notes', 'reminderTimes',
        'pharmacy', 'prescriber', 'pharmacyName', 'pharmacyContact',
        'doctorName', 'doctorContact', 'createdAt', 'updatedAt',
        'userId', 'uid'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             // id validation
             data.id is string &&
             data.id.size() >= 1 &&
             data.id.size() <= 100 &&
             // name validation (max 100 chars)
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 100 &&
             // dosage validation (max 50 chars)
             data.dosage is string &&
             data.dosage.size() >= 1 &&
             data.dosage.size() <= 50 &&
             // form validation (max 50 chars)
             data.form is string &&
             data.form.size() >= 1 &&
             data.form.size() <= 50 &&
             // reminderTimes validation
             ((data.reminderTimes is list && data.reminderTimes.size() <= 24) ||
              (data.reminderTimes is map && data.reminderTimes.keys().size() <= 24)) &&
             // timestamps
             ('createdAt' in data && isValidTimeField(data.createdAt)) &&
             ('updatedAt' in data && isValidTimeField(data.updatedAt)) &&
             // notes validation (max 500 chars)
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             // optional pharmacy
             (!('pharmacy' in data) ||
              (data.pharmacy is map && data.pharmacy.keys().size() <= 20) ||
              (data.pharmacy is string && data.pharmacy.size() <= 200)) &&
             // optional prescriber
             (!('prescriber' in data) ||
              (data.prescriber is map && data.prescriber.keys().size() <= 20) ||
              (data.prescriber is string && data.prescriber.size() <= 200)) &&
             // optional flat contact fields
             (!('pharmacyName' in data) || (data.pharmacyName is string && data.pharmacyName.size() <= 100)) &&
             (!('pharmacyContact' in data) || (data.pharmacyContact is string && data.pharmacyContact.size() <= 50)) &&
             (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() <= 100)) &&
             (!('doctorContact' in data) || (data.doctorContact is string && data.doctorContact.size() <= 50)) &&
             // ownership scoping
             (!('userId' in data) || data.userId == userId) &&
             (!('uid' in data) || data.uid == userId);
    }

    // Validate medicine update (protects immutable ownership and creation fields)
    function isMedicineUpdateValid(medicineId, userId) {
      return isValidMedicine(request.resource.data, medicineId, userId) &&
             (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
             request.resource.data.id == resource.data.id &&
             (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId) &&
             (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid);
    }

    // Validate history document schema and constraints
    function isValidHistory(data, historyId, userId) {
      let requiredFields = ['id', 'medicineId', 'medicineName', 'scheduledTime', 'status'];
      let allowedFields = [
        'id', 'medicineId', 'medicineName', 'scheduledTime', 'status',
        'takenTime', 'date', 'dosage', 'slot', 'notes',
        'createdAt', 'timestamp', 'updatedAt', 'userId', 'uid'
      ];
      let validStatuses = ['ON_TIME', 'SLIGHTLY_LATE', 'VERY_LATE', 'MISSED'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string &&
             data.id.size() >= 1 &&
             data.id.size() <= 100 &&
             data.medicineId is string &&
             data.medicineId.size() >= 1 &&
             data.medicineId.size() <= 100 &&
             data.medicineName is string &&
             data.medicineName.size() >= 1 &&
             data.medicineName.size() <= 100 &&
             (data.scheduledTime is timestamp ||
              (data.scheduledTime is string && data.scheduledTime.size() >= 1 && data.scheduledTime.size() <= 50)) &&
             data.status in validStatuses &&
             (('createdAt' in data && isValidTimeField(data.createdAt)) ||
              ('timestamp' in data && isValidTimeField(data.timestamp))) &&
             (!('takenTime' in data) ||
              data.takenTime == null ||
              data.takenTime is timestamp ||
              (data.takenTime is string && data.takenTime.size() <= 50)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 20)) &&
             (!('dosage' in data) || (data.dosage is string && data.dosage.size() <= 50)) &&
             (!('slot' in data) || (data.slot is string && data.slot.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('updatedAt' in data) || isValidTimeField(data.updatedAt)) &&
             (!('userId' in data) || data.userId == userId) &&
             (!('uid' in data) || data.uid == userId);
    }

    // Validate history update (protects immutable ownership and creation fields)
    function isHistoryUpdateValid(historyId, userId) {
      return isValidHistory(request.resource.data, historyId, userId) &&
             (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
             (!('timestamp' in resource.data) || request.resource.data.timestamp == resource.data.timestamp) &&
             request.resource.data.id == resource.data.id &&
             request.resource.data.medicineId == resource.data.medicineId &&
             (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId) &&
             (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid);
    }

    // ===============================================================
    // Rules Definition (Deny by Default)
    // ===============================================================

    // Root default deny rule: all unmatched paths are denied
    match /{document=**} {
      allow read, write: if false;
    }

    // 1G: phone_index/{hash}: deny ALL client read, list, write, delete.
    // Only Cloud Functions using the Firebase Admin SDK can access this collection.
    match /phone_index/{hash} {
      allow read, write: if false;
    }

    // 1G: users/{userId}: read and write only if request.auth.uid == userId AND email_verified == true.
    // Profile creation is strictly done via completeSignUp Cloud Function (Admin SDK) to prevent spoofing createdAt/uid.
    match /users/{userId} {
      allow read: if isVerifiedUser(userId);
      allow create: if false;
      allow update: if isVerifiedUser(userId) && isUserUpdateValid(userId);
      allow delete: if false; // Cleaned up via Cloud Function auth onDelete trigger

      // Medicines subcollection
      match /medicines/{medicineId} {
        allow read: if isVerifiedUser(userId);
        allow create: if isVerifiedUser(userId) && isValidMedicine(request.resource.data, medicineId, userId);
        allow update: if isVerifiedUser(userId) && isMedicineUpdateValid(medicineId, userId);
        allow delete: if isVerifiedUser(userId);
      }

      // History subcollection
      match /history/{historyId} {
        allow read: if isVerifiedUser(userId);
        allow create: if isVerifiedUser(userId) && isValidHistory(request.resource.data, historyId, userId);
        allow update: if isVerifiedUser(userId) && isHistoryUpdateValid(historyId, userId);
        allow delete: if isVerifiedUser(userId);
      }
    }
  }
}
